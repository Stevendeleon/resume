{{define "experience-section"}}
<section class="resume-section experience" aria-labelledby="experience-title">
    <h2 id="experience-title" class="section-title">Experience</h2>
    {{range .Experience}}
        <article class="job">
            <div class="job-header">
                <div>
                    <div class="job-meta">
                        <h3 class="job-title"><strong>{{.Role}}</strong>,</h3> <span class="company">{{.Company}}</span> <span class="sep">—</span> <span class="location">{{.Location}}</span>
                    </div>
                </div>
                <div class="job-dates">{{.Start}}
                    {{if .End}} <span class="sep">—</span> {{.End}}{{else}}<span class="sep">—</span> <span>Present</span>{{end}}
                </div>
            </div>
            {{ if .Clients }}
            <p style="">Clients:
                {{- $currentClients := .Clients -}}
                {{- range $index, $client := .Clients -}}
                    {{- $client -}}{{- if ne $index (lenMinusOne $currentClients) -}}, {{end -}}
                {{- end -}}
            {{ end }}
            <ul class="job-details" role="list">
                {{range .Details}}
                    <li>{{.}}</li>
                {{end}}
            </ul>
        </article>
    {{end}}
</section>
{{end}}