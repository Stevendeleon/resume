<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <meta name="author" content="{{.MetaData.Author}}">
    <meta name="description" content="{{.MetaData.Description}}">
    <style>
        :root {
            --text: #111;
            --muted: #555;
            --border: #000;
            --font: "Arial", system-ui, -apple-system, Segoe UI, Roboto, Helvetica, sans-serif;

            --fs-body: 10pt;
            --fs-title: 18pt;
            --fs-section: 12pt;
            --fs-job-title: 11pt;
            --lh: 1.25;

            --gap-section: 0.75rem;
            --gap-list: 0.1rem;
            --pad-x: 0.6in;
            --maxw: 8in;
        }

        html, body {
            margin: 0;
            padding: 0;
            color: var(--text);
            font-family: var(--font);
            font-size: var(--fs-body);
            line-height: var(--lh);
            background: #fff;
        }

        main.resume {
            max-width: var(--maxw);
            margin: 0 auto;
            padding: 0.4in var(--pad-x);
        }

        header.resume-header {
            text-align: center;
            margin-bottom: 0.6rem;
        }

        .name {
            font-size: 18pt;
            font-weight: 700;
            margin: 0;
            line-height: 1.1;
        }

        .contact {
            margin: 0.2rem 0 0 0;
            color: var(--muted);
            font-size: 9.5pt;

            a {
                color: inherit;
                text-decoration: none;

                &:hover, &:focus {
                    text-decoration: underline;
                }
            }
        }

        section.resume-section {
            margin-bottom: var(--gap-section);
        }

        .section-title {
            margin: 0 0 0.35rem 0;
            padding-bottom: 0.15rem;
            border-bottom: 1px solid var(--border);
            font-size: var(--fs-section);
            font-weight: 700;
        }

        .summary p {
            margin: 0;
        }

        /* Skills */
        .skills {
            .skill-list {
                margin: 0;
                padding: 0;
                list-style: none;
            }

            .skill-item + .skill-item { margin-top: 0.2rem; }
            .label { font-weight: 700; }
        }

        /* Experience */
        .experience .job {
            margin-bottom: 0.6rem;
        }
        .job-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            gap: 0.6rem;
            flex-wrap: wrap;
        }

        .job-meta {
            display: flex;
            gap: 0.3rem;
            flex-wrap: wrap;
            align-items: baseline;

            span { line-height: 1; }
            .sep { opacity: 0.6; }
        }

        .job-title {
            margin: 0;
            display: inline;
            font-size: 1em;
            line-height: 1;
        }

        .job-dates {
            color: var(--muted);
            font-style: italic;
            white-space: nowrap;
        }

        .job-details {
            margin: 0.25rem 0 0 1rem;
            padding: 0;
            list-style: disc;

            li { margin-bottom: var(--gap-list); }
        }

        /* Education */
        .education {
            .edu-item {
                display: flex;
                justify-content: space-between;
                align-items: baseline;
                gap: 0.6rem;
                flex-wrap: wrap;
                margin-bottom: 0.25rem;
            }

            .edu-left {
                span { font-weight: 700; }
            }

            .edu-right {
                color: var(--muted);
                font-style: italic;
                white-space: nowrap;
            }
        }

        @page {
            size: Letter;
            margin: 0.5in;
        }
        @media print {
            a[href]:after { content: ""; }

            header, h2, h3 { page-break-after: avoid; }
            .job, .edu-item { page-break-inside: avoid; }

            html, body { font-size: 9.8pt; }
            main.resume { padding: 0; max-width: 100%; }
        }

        @media (max-width: 1024px) {
            :root {
                --fs-title: 19pt;
                --pad-x: 0.5in;
                --maxw: 7.2in;
            }
        }
    </style>
    <title>{{.MetaData.Title}}</title>
</head>
<body>
    <main class="resume" role="main" aria-label="Resume">
        {{ template "heading-section" .Resume }}
        {{ template "summary-section" .Resume }}
        {{ template "skills-section" .Resume }}
        {{ template "experience-section" .Resume }}
        {{ template "education-section" .Resume.Education }}
    </main>
</body>
</html>
