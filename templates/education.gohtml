{{define "education-section"}}
<section class="resume-section education" aria-labelledby="education-title">
    <h2 class="section-title">Education</h2>
    <div class="edu-item">
    {{- range .}}
        <div class="edu-left"><span>{{- .School -}}</span> — {{.Degree }} in {{.Major -}}</div>
        <div class="edu-right">{{ if .Year }}{{- .Year -}}{{end}}</div>
    {{end -}}
    </div>
</section>
{{end}}