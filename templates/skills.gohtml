{{define "skills-section"}}
<section class="resume-section skills" aria-labelledby="skillsHeader">
    <h2 id="skills-title" class="section-title">Skills</h2>
    <ul class="skill-list" role="list">
    {{- range .Skills -}}{{$currentSkill := .}}
        <li class="skill-item">
            <span class="label">{{.Name}}:</span>
            <span class="value">{{- range $index, $item := .Items -}}{{$item}}{{- if ne $index (lenMinusOne $currentSkill.Items) -}}, {{end -}}{{- end -}}</span>
        </li>
    {{end}}
    </ul>
</section>
{{end}}