{{define "heading-section" }}
<header class="resume-header" role="banner" aria-labelledby="about header">
    <h1 class="name">{{.Name}}</h1>
    <p>{{.Location}} | {{phoneToText .Phone}} | <a href="mailto:{{.Email}}">{{.Email}}</a> | <a href="{{.LinkedInUrl}}" target="_blank">{{formatUrl .LinkedInUrl}}</a></p>
</header>
{{end}}